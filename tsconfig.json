{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // WhatsApp files excluded because @whiskeysockets/baileys is not installed yet.
  // Remove these exclusions after running /add-whatsapp to install WhatsApp dependencies.
  "exclude": ["node_modules", "dist", "src/channels/whatsapp.ts", "src/channels/whatsapp.test.ts", "src/whatsapp-auth.ts"]
}
